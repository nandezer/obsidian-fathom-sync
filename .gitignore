# Build artefacts
main.js
main.js.map
*.tsbuildinfo

# Dependencies
node_modules/

# Temp / local
install.log
install.err
*.log
.release-staging/
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Test vault data (in case anyone tests in a vault checked into this repo)
.obsidian/

# Release zips kept under releases/ are fine; ignore ad-hoc zips at root
/fathom-sync-*.zip

# Cloudflare Worker (v2) local state
worker/node_modules/
worker/.wrangler/
worker/.miniflare/
worker/.dev.vars
worker/.dev.vars.*

# Env / secrets (defence in depth)
.env
.env.*
*.env
.dev.vars

# Obsidian plugin runtime state. data.json is generated per-install and
# can contain the user's Fathom API token and any registered webhook ID.
# It must never be committed.
data.json

# Backups
*.bak
*~

# Local commit-message scratch (used by the build pipeline to avoid
# PowerShell here-string quoting issues — never meant to be tracked)
.commit-msg.txt
